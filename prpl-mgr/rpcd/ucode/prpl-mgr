#!/usr/bin/ucode -RS

import { connect } from  "ubus";

function wireless_reload() {
	system("wifi reload");
}

function reload(req) {
	let ret = {"status" : "success"};
	try {
		wireless_reload();
	} catch (e) {
		ret["status"] = "failed";
		ret["error"] = e.message;
	}
	return ret;
}

return { prpl_mgr: {
	reload: {
		call: reload,
		args: {
			radio_config:{},
		}
	},
}};
